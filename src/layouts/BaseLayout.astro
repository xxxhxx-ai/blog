---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import petImage from '../assets/hero/maid.png';

interface Props {
  title: string;
  description?: string;
  /** 用于 <title> 的后缀，首页留空 */
  suffix?: boolean;
}

const {
  title,
  description = 'lxxxhxx 的学习笔记与作品集 —— 一个还在学着把想法做出来的人。',
  suffix = true,
} = Astro.props;

const fullTitle = suffix ? `${title} · lxxxhxx` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://lxxxhxx.github.io');
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="lxxxhxx" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07080d" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 视图过渡：站内跳转不刷新，像应用一样切换 -->
    <ClientRouter />

    <!-- 主题初始化：必须在样式生效前执行，否则会闪白 -->
    <script is:inline>
      (function () {
        try {
          var forced = new URLSearchParams(location.search).get('theme');
          if (forced === 'light' || forced === 'dark') {
            document.documentElement.dataset.theme = forced;
            return;
          }
          if (document.documentElement.dataset.theme) return;
          var saved = localStorage.getItem('theme');
          var prefersLight = !window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (prefersLight ? 'light' : 'dark');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // 入场动画：每次导航后重新观察新内容
      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        els.forEach((el) => io.observe(el));
      }

      // 导航后回到顶部（浏览器的前进后退不强制，交给浏览器自身）
      let firstLoad = true;
      document.addEventListener('astro:page-load', () => {
        initReveal();
        if (!firstLoad) window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        firstLoad = false;
      });
      initReveal();
    </script>

    <!-- ================= 桌面宠物 ================= -->
    <style is:inline>
      /* 右下角悬浮的看板娘 */
      #pet {
        position: fixed;
        right: 12px;
        bottom: 6px;
        z-index: 40;
        width: 196px;
        line-height: 0;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        transform-origin: bottom center;
        /* 入场：从下方升起 */
        animation: petEnter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      #pet.pet-dragging {
        cursor: grabbing;
      }
      @keyframes petEnter {
        from {
          opacity: 0;
          transform: translateY(60px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* 主体：呼吸浮动 + 鼠标跟随（--px/--py 由脚本写入） */
      #pet .pet-body {
        display: block;
        width: 100%;
        height: auto;
        transform: translate(calc(var(--px, 0) * 7px), calc(var(--py, 0) * 5px))
          rotate(calc(var(--px, 0) * 2.2deg));
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        filter: drop-shadow(0 12px 26px rgba(8, 6, 18, 0.55));
        animation: petFloat 4.5s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes petFloat {
        0%,
        100% {
          margin-bottom: 0;
        }
        50% {
          margin-bottom: 7px;
        }
      }

      /* 被点击时跳一下 */
      #pet.pet-jump .pet-body {
        animation: petJump 0.55s cubic-bezier(0.28, 1.6, 0.5, 1);
      }
      @keyframes petJump {
        0% { margin-bottom: 0; }
        35% { margin-bottom: 20px; }
        65% { margin-bottom: 0; }
        82% { margin-bottom: 6px; }
        100% { margin-bottom: 0; }
      }

      /* 台词气泡 */
      #pet .pet-bubble {
        position: absolute;
        right: 6px;
        bottom: calc(100% + 6px);
        max-width: 190px;
        padding: 9px 13px;
        border-radius: 12px 12px 12px 4px;
        background: rgba(22, 29, 43, 0.96);
        border: 1px solid rgba(150, 160, 255, 0.24);
        color: #e8ebf7;
        font-size: 12.5px;
        line-height: 1.65;
        white-space: normal;
        box-shadow: 0 10px 26px -14px rgba(0, 0, 0, 0.85);
        opacity: 0;
        transform: translateY(6px) scale(0.96);
        transform-origin: bottom right;
        transition: opacity 0.24s ease, transform 0.24s ease;
        pointer-events: none;
      }
      #pet .pet-bubble.show {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      /* 拖拽时关掉抖动 */
      #pet.pet-dragging .pet-body {
        animation: none;
        transform: none;
      }

      /* 手机端、窄屏不显示 */
      @media (max-width: 767px) {
        #pet {
          display: none !important;
        }
      }
    </style>

    <aside id="pet" aria-hidden="true" transition:persist>
      <div class="pet-bubble" data-pet-bubble></div>
      <Image
        src={petImage}
        alt=""
        width={340}
        height={496}
        format="webp"
        quality={88}
        class="pet-body"
        data-pet-body
      />
    </aside>

    <script is:inline>
      (function () {
        var LINES = [
          '今天也要加油哦！',
          '记得喝口水~',
          '嘿，又见面啦',
          '点我干嘛呀？',
          '这个站还挺好看的吧',
          '要不要去看看文章？',
          '休息一下也很好',
          '别一直盯着屏幕啦',
        ];

        var el = document.getElementById('pet');
        if (!el) return;
        if (el.dataset.petReady === '1') return;
        el.dataset.petReady = '1';

        var bubble = el.querySelector('[data-pet-bubble]');
        var body = el.querySelector('[data-pet-body]');
        var hideTimer = 0;
        var jumpTimer = 0;

        /* ---- 鼠标跟随：让小人轻微转向光标 ---- */
        if (window.matchMedia('(pointer: fine)').matches) {
          window.addEventListener(
            'mousemove',
            function (e) {
              var r = el.getBoundingClientRect();
              if (!r.width) return;
              var cx = r.left + r.width / 2;
              var cy = r.top + r.height / 2;
              var dx = (e.clientX - cx) / (window.innerWidth / 2);
              var dy = (e.clientY - cy) / (window.innerHeight / 2);
              el.style.setProperty('--px', Math.max(-1, Math.min(1, dx)).toFixed(3));
              el.style.setProperty('--py', Math.max(-1, Math.min(1, dy)).toFixed(3));
            },
            { passive: true }
          );
        }

        /* ---- 说话 ---- */
        function say(text) {
          if (!bubble) return;
          bubble.textContent = text;
          bubble.classList.add('show');
          clearTimeout(hideTimer);
          hideTimer = setTimeout(function () {
            bubble.classList.remove('show');
          }, 3200);
        }

        /* ---- 点击：跳一下 + 说话 ---- */
        el.addEventListener('click', function (e) {
          if (el.dataset.petMoved === '1') {
            el.dataset.petMoved = '0';
            return;
          }
          clearTimeout(jumpTimer);
          el.classList.remove('pet-jump');
          void el.offsetWidth;
          el.classList.add('pet-jump');
          jumpTimer = setTimeout(function () {
            el.classList.remove('pet-jump');
          }, 600);

          say(LINES[Math.floor(Math.random() * LINES.length)]);
        });

        /* ---- 拖拽 ---- */
        var drag = null;
        var THRESHOLD = 4;

        el.addEventListener('pointerdown', function (e) {
          if (e.button !== 0 && e.pointerType === 'mouse') return;
          var r = el.getBoundingClientRect();
          drag = {
            x: e.clientX,
            y: e.clientY,
            moved: false,
            right: Math.max(0, window.innerWidth - r.right),
            bottom: Math.max(0, window.innerHeight - r.bottom),
          };
          try {
            el.setPointerCapture(e.pointerId);
          } catch (err) {}
        });

        el.addEventListener('pointermove', function (e) {
          if (!drag) return;
          var dx = e.clientX - drag.x;
          var dy = e.clientY - drag.y;
          if (!drag.moved && Math.abs(dx) + Math.abs(dy) < THRESHOLD) return;

          if (!drag.moved) {
            drag.moved = true;
            el.classList.add('pet-dragging');
            el.style.animation = 'none';
            el.style.opacity = '1';
          }

          var right = Math.min(window.innerWidth - 70, Math.max(0, drag.right - dx));
          var bottom = Math.min(window.innerHeight - 90, Math.max(0, drag.bottom + dy));
          el.style.right = right + 'px';
          el.style.bottom = bottom + 'px';
        });

        function endDrag() {
          if (!drag) return;
          var moved = drag.moved;
          drag = null;
          el.classList.remove('pet-dragging');
          if (moved) {
            // 拖完那一下不要触发点击
            el.dataset.petMoved = '1';
            setTimeout(function () {
              el.dataset.petMoved = '0';
            }, 300);
            say('放我下来啦~');
          }
        }
        el.addEventListener('pointerup', endDrag);
        el.addEventListener('pointercancel', endDrag);

        /* ---- 第一次进站打个招呼 ---- */
        setTimeout(function () {
          say('你好呀，我是这个站的小看板娘');
        }, 2200);
      })();
    </script>
    <!-- ================= /桌面宠物 ================= -->

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 999;
        padding: 12px 20px;
        background: var(--accent);
        color: #07080d;
        border-radius: 0 0 8px 0;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
