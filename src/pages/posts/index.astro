---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postUrl, wordCount, CATEGORIES, tagList } from '../../lib/posts';

const posts = await getPosts();
const tags = tagList(posts).slice(0, 8);
---

<BaseLayout title="全部文章" description="lxxxhxx 写过的所有文章，按时间倒序排列。">
  <PageHeader
    kicker="// ALL POSTS"
    title="全部文章"
    desc="按时间倒序。想按主题找就去分类，想按关键词找就看标签。"
    meta={`TOTAL ${posts.length} POSTS`}
    chibiTone={0}
  />

  <div class="shell body">
    <div class="filters">
      <div class="f-group">
        <span class="f-label mono">分类</span>
        {CATEGORIES.map((c) => (
          <a href={`/categories/${c.slug}`} class="chip">{c.name}</a>
        ))}
      </div>
      <div class="f-group">
        <span class="f-label mono">标签</span>
        {tags.map(([t]) => (
          <a href={`/tags/${encodeURIComponent(t)}`} class="chip">{t}</a>
        ))}
      </div>
    </div>

    <div class="list">
      {posts.map((p, i) => (
        <PostCard
          href={postUrl(p)}
          title={p.data.title}
          description={p.data.description}
          date={p.data.pubDate}
          category={p.data.category}
          tags={p.data.tags}
          index={p.data.index ?? String(i + 1).padStart(2, '0')}
          words={wordCount(p.body)}
        />
      ))}
    </div>

    <p class="foot-note mono">
      END OF LIST · {posts.length} ENTRIES
    </p>
  </div>
</BaseLayout>

<style>
  .body { padding-top: 34px; }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 26px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--line-soft);
  }
  .f-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .f-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-3);
    width: 34px;
    flex-shrink: 0;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .foot-note {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-3);
    text-align: center;
    opacity: 0.7;
  }
</style>
