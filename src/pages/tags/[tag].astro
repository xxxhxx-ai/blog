---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postUrl, wordCount, tagList } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return tagList(posts).map(([tag]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
};

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的全部文章。`}>
  <PageHeader
    kicker="// TAG"
    title={`#${tag}`}
    desc={`所有带这个标签的文章，共 ${posts.length} 篇。`}
    meta="按时间倒序"
  />

  <div class="shell body">
    <a href="/tags" class="chip back mono">← 全部标签</a>
    <div class="list">
      {posts.map((p, i) => (
        <PostCard
          href={postUrl(p)}
          title={p.data.title}
          description={p.data.description}
          date={p.data.pubDate}
          category={p.data.category}
          tags={p.data.tags}
          index={String(i + 1).padStart(2, '0')}
          words={wordCount(p.body)}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .body { padding-top: 30px; }
  .back { margin-bottom: 22px; font-size: 11px; }
  .list { display: flex; flex-direction: column; gap: 14px; }
</style>
