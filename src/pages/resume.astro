---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { RESUME, SITE } from '../data/site';
---

<BaseLayout title="简历" description={`${RESUME.name} 的简历。`}>
  <PageHeader
    kicker="// RESUME"
    title="简历"
    desc="一页能看完的版本。如果需要 PDF，浏览器的打印功能直接就能导出。"
    meta={`UPDATED ${new Date().getFullYear()}.${String(new Date().getMonth() + 1).padStart(2, '0')}`}
    chibiTone={1}
  />

  <div class="shell body">
    <div class="resume">
      <header class="r-head">
        <div>
          <h1>{RESUME.name}</h1>
          <p class="r-title">{RESUME.title}</p>
        </div>
        <div class="r-contact mono">
          <span>{RESUME.location}</span>
          {(RESUME.contact ?? []).map((c) => (
            <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {c.label} · {c.value}
            </a>
          ))}
        </div>
      </header>

      <section class="r-sec">
        <h2 class="mono">// 简介</h2>
        <p class="r-summary">{RESUME.summary}</p>
      </section>

      <section class="r-sec">
        <h2 class="mono">// 技能</h2>
        <div class="skills">
          {(RESUME.skills ?? []).map((s) => (
            <div class="skill-row">
              <span class="sk-k mono">{s.group}</span>
              <div class="sk-items">
                {(s.items ?? []).map((it) => <span class="chip">{it}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="r-sec">
        <h2 class="mono">// 经历</h2>
        <div class="timeline">
          {(RESUME.timeline ?? []).map((t) => (
            <div class="tl-item">
              <span class="tl-period mono">{t.period}</span>
              <div class="tl-body">
                <h3>{t.title}</h3>
                <p>{t.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="r-sec">
        <h2 class="mono">// 作品</h2>
        <p class="r-summary">
          完整列表见 <a href="/works">作品集</a> 页面，每个项目都有对应的过程记录。
        </p>
      </section>

      <footer class="r-foot mono">
        <span>{SITE.name} · RESUME</span>
        <span>打印本页即可导出 PDF</span>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .body { padding-top: 34px; }

  .resume {
    max-width: 860px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    padding: 40px 44px;
  }

  .r-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }
  .r-head h1 {
    font-size: 32px;
    letter-spacing: 0.02em;
    margin-bottom: 6px;
  }
  .r-title {
    font-size: 14px;
    color: var(--accent-2);
    letter-spacing: 0.04em;
  }
  .r-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  .r-contact a { transition: color 0.2s ease; }
  .r-contact a:hover { color: var(--accent); }

  .r-sec { padding-top: 30px; }
  .r-sec h2 {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: var(--accent-2);
    margin-bottom: 16px;
    font-weight: 500;
  }
  .r-summary {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.95;
    max-width: min(68ch, 100%);
  }
  .r-summary a {
    color: var(--accent-2);
    border-bottom: 1px solid var(--line-strong);
  }

  .skills { display: flex; flex-direction: column; gap: 12px; }
  .skill-row {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 16px;
    align-items: center;
  }
  .sk-k {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }
  .sk-items { display: flex; flex-wrap: wrap; gap: 6px; }

  .timeline { display: flex; flex-direction: column; gap: 20px; }
  .tl-item {
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: 18px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }
  .tl-item:last-child { border-bottom: none; padding-bottom: 0; }
  .tl-period {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text-3);
    padding-top: 3px;
  }
  .tl-body h3 {
    font-size: 15.5px;
    margin-bottom: 6px;
  }
  .tl-body p {
    font-size: 13.2px;
    color: var(--text-2);
    line-height: 1.82;
  }

  .r-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--text-3);
    opacity: 0.75;
  }

  @media (max-width: 700px) {
    .resume { padding: 26px 22px; }
    .r-head { flex-direction: column; gap: 14px; }
    .r-contact { align-items: flex-start; }
    .tl-item, .skill-row { grid-template-columns: 1fr; gap: 6px; }
    .r-head h1 { font-size: 26px; }
  }

  @media print {
    :global(body) { background: #fff !important; }
    .resume { border: none; background: #fff; padding: 0; }
  }
</style>
